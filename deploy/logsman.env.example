# Production settings for Logsman. Copy to /etc/logsman/logsman.env,
# then: sudo chown root:logsman /etc/logsman/logsman.env && sudo chmod 0640 /etc/logsman/logsman.env

LOGSMAN_APP_ENV=production
# Never true in production: debug mode returns stack traces to clients.
LOGSMAN_DEBUG=false

# MongoDB with authentication enabled. URL-encode special characters in the password.
LOGSMAN_MONGODB_URL=mongodb://logsman:CHANGE_ME@127.0.0.1:27017/logsman?authSource=logsman
LOGSMAN_MONGODB_DATABASE=logsman
LOGSMAN_MONGODB_COLLECTION=events

# The BEACN server and a key with events:read in the publishers' environment.
LOGSMAN_BEACN_URL=https://beacn.internal.example.com
LOGSMAN_BEACN_API_KEY=bk_REPLACE_ME
LOGSMAN_BEACN_TOPIC=logs
LOGSMAN_BEACN_ENABLED=true
